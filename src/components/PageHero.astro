---
import type { Crumb } from '../layouts/Base.astro';
interface Props { title: string; lead?: string; kicker?: string; crumbs?: Crumb[] }
const { title, lead, kicker, crumbs = [] } = Astro.props;
const hasArt = Astro.slots.has('art');
---
<section class:list={['page-hero', { 'no-art': !hasArt }]}>
  <div class="wrap">
    <div>
      {crumbs.length > 0 && (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {crumbs.map((c, i) => i === crumbs.length - 1
              ? <li><span aria-current="page">{c.name}</span></li>
              : <li><a href={c.href}>{c.name}</a></li>)}
          </ol>
        </nav>
      )}
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot name="actions" />
    </div>
    {hasArt && <div class="art"><slot name="art" /></div>}
  </div>
</section>
