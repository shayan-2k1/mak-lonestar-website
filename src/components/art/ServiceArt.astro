---
// Service illustrations (400×300). Illustrative technical drawings, not photographs of MAK Lonestar work.
interface Props { kind: 'geotech' | 'cmt' | 'drilling' | 'environmental'; label?: boolean }
const { kind } = Astro.props;
const titles: Record<string, string> = {
  geotech: 'Illustration of a soil boring through layered strata beside a boring log with sample intervals',
  cmt: 'Illustration of a concrete cylinder under load in a compression testing machine',
  drilling: 'Illustration of a truck-mounted drill rig mast advancing an auger with a Shelby tube sample',
  environmental: 'Illustration of a sampling boring reaching the groundwater table with soil and water sample containers',
};
const uid = `sa-${kind}`;
---
<svg class="service-art" viewBox="0 0 400 300" role="img" aria-label={titles[kind]} preserveAspectRatio="xMidYMid slice">
  <defs>
    <pattern id={`${uid}-grid`} width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" fill="none" stroke="#f0f0f2" stroke-opacity=".06" /></pattern>
  </defs>
  <rect width="400" height="300" fill="#141416" />
  <rect width="400" height="300" fill={`url(#${uid}-grid)`} />

  {kind === 'geotech' && (
    <g>
      <path d="M30 96 Q110 90 200 97 T370 95 V270 H30Z" fill="#4b3d31" />
      <path d="M30 118 Q120 112 210 120 T370 116 V270 H30Z" fill="#7c4a32" />
      <path d="M30 168 Q140 160 230 168 T370 166 V270 H30Z" fill="#a97c55" />
      <path d="M30 206 Q130 200 220 208 T370 204 V270 H30Z" fill="#6c6f6a" />
      <path d="M30 244 Q150 238 250 246 T370 242 V270 H30Z" fill="#cbc2ae" />
      <rect x="30" y="94" width="340" height="176" fill="none" stroke="#f0f0f2" stroke-opacity=".25" />
      <rect x="104" y="60" width="10" height="196" fill="#1a1512" />
      <path d="M100 60 h18 v-30 h-18z" fill="#b3093f" />
      <g fill="#e8e1d1"><rect x="118" y="126" width="16" height="9" rx="2" /><rect x="118" y="150" width="16" height="9" rx="2" /><rect x="118" y="182" width="16" height="9" rx="2" /><rect x="118" y="220" width="16" height="9" rx="2" /></g>
      <g transform="translate(262 40)">
        <rect width="92" height="216" rx="6" fill="#f3f2ef" />
        <rect x="10" y="12" width="20" height="18" fill="#4b3d31" /><rect x="10" y="30" width="20" height="52" fill="#7c4a32" /><rect x="10" y="82" width="20" height="40" fill="#a97c55" /><rect x="10" y="122" width="20" height="40" fill="#6c6f6a" /><rect x="10" y="162" width="20" height="42" fill="#cbc2ae" />
        <g stroke="#141416" stroke-opacity=".35"><path d="M38 40 h44 M38 64 h44 M38 96 h44 M38 134 h44 M38 176 h44" /></g>
        <g fill="#c41248"><rect x="38" y="36" width="18" height="7" rx="2" /><rect x="38" y="60" width="26" height="7" rx="2" /><rect x="38" y="92" width="34" height="7" rx="2" /><rect x="38" y="130" width="44" height="7" rx="2" /><rect x="38" y="172" width="40" height="7" rx="2" /></g>
      </g>
    </g>
  )}

  {kind === 'cmt' && (
    <g>
      <rect x="40" y="262" width="320" height="10" rx="3" fill="#2c2c31" />
      <g fill="#3d3d43"><rect x="92" y="54" width="18" height="210" /><rect x="236" y="54" width="18" height="210" /></g>
      <g fill="#66666e"><rect x="92" y="54" width="4" height="210" /><rect x="236" y="54" width="4" height="210" /></g>
      <rect x="76" y="40" width="194" height="28" rx="4" fill="#2c2c31" />
      <rect x="76" y="40" width="194" height="4" rx="2" fill="#7a7a82" />
      <rect x="160" y="68" width="26" height="40" fill="#8f8f96" />
      <rect x="136" y="108" width="74" height="12" rx="2" fill="#cdcdd1" />
      <rect x="140" y="122" width="66" height="112" rx="4" fill="#d4cfc4" />
      <rect x="140" y="122" width="10" height="112" fill="#fff" opacity=".35" />
      <g fill="#a59f92"><circle cx="160" cy="146" r="2.2" /><circle cx="184" cy="160" r="1.8" /><circle cx="170" cy="188" r="2.4" /><circle cx="192" cy="208" r="1.6" /><circle cx="156" cy="214" r="1.9" /><circle cx="194" cy="136" r="1.5" /></g>
      <rect x="128" y="234" width="90" height="14" rx="2" fill="#cdcdd1" />
      <rect x="110" y="248" width="126" height="16" fill="#3d3d43" />
      <path d="M173 86 v14 m-7-7 7 7 7-7" stroke="#f58fa9" stroke-width="2.4" fill="none" stroke-linecap="round" />
      <g transform="translate(316 120)">
        <circle r="40" fill="#f3f2ef" /><circle r="40" fill="none" stroke="#2c2c31" stroke-width="5" />
        <g stroke="#141416" stroke-width="2" stroke-linecap="round"><path d="M-28 0h6M22 0h6M0-28v6M-20-20l4 4M20-20l-4 4" /></g>
        <path d="M0 0 L20 -18" stroke="#c41248" stroke-width="3" stroke-linecap="round" /><circle r="4" fill="#141416" />
      </g>
      <g transform="translate(300 196)">
        <rect width="34" height="62" rx="3" fill="#d4cfc4" /><rect x="40" y="10" width="34" height="52" rx="3" fill="#bdb6a8" />
        <rect width="8" height="62" fill="#fff" opacity=".3" />
      </g>
    </g>
  )}

  {kind === 'drilling' && (
    <g>
      <path d="M0 218 Q120 212 220 219 T400 216 V300 H0Z" fill="#7c4a32" />
      <path d="M0 262 Q140 255 240 263 T400 260 V300 H0Z" fill="#a97c55" />
      <path d="M0 218 Q120 212 220 219 T400 216" stroke="#8d7a63" stroke-width="2" fill="none" />
      <path d="M150 20 h40 v186 h-40z" fill="#b3093f" />
      <path d="M150 20 h6 v186 h-6z" fill="#d94a73" opacity=".8" />
      <path d="M150 40 l40 30 M190 40 l-40 30 M150 96 l40 30 M190 96 l-40 30 M150 152 l40 30 M190 152 l-40 30" stroke="#7a0029" stroke-width="2.4" />
      <rect x="166" y="16" width="8" height="270" fill="#cdcdd1" />
      <rect x="160" y="220" width="20" height="70" fill="#1a1512" />
      <path d="M160 232 l20 8 M160 248 l20 8 M160 264 l20 8 M160 280 l20 8" stroke="#a0a0a6" stroke-width="3" />
      <rect x="154" y="140" width="32" height="24" rx="3" fill="#3d3d43" />
      <rect x="60" y="196" width="230" height="22" rx="4" fill="#2c2c31" />
      <rect x="60" y="196" width="230" height="3" fill="#66666e" />
      <g transform="translate(250 70) rotate(18)">
        <rect width="20" height="120" rx="3" fill="#cdcdd1" />
        <rect y="60" width="20" height="60" fill="#7c4a32" />
        <rect width="5" height="120" fill="#fff" opacity=".4" />
      </g>
      <g transform="translate(300 160)">
        <rect width="70" height="34" rx="4" fill="#f3f2ef" />
        <rect x="8" y="9" width="54" height="5" rx="2" fill="#7c4a32" /><rect x="8" y="20" width="40" height="5" rx="2" fill="#a97c55" />
      </g>
    </g>
  )}

  {kind === 'environmental' && (
    <g>
      <path d="M0 120 Q120 112 220 120 T400 116 V300 H0Z" fill="#4b3d31" />
      <path d="M0 142 Q130 136 230 144 T400 140 V300 H0Z" fill="#a97c55" />
      <path d="M0 196 Q120 190 220 198 T400 194 V300 H0Z" fill="#6a8c94" opacity=".85" />
      <path d="M0 196 Q120 190 220 198 T400 194" stroke="#bfe0ea" stroke-width="2" stroke-dasharray="8 6" fill="none" />
      <path d="M28 182 l9 10 9-10z" fill="#bfe0ea" />
      <path d="M0 120 Q120 112 220 120 T400 116" stroke="#8d7a63" stroke-width="2" fill="none" />
      <rect x="182" y="84" width="16" height="190" fill="#e7e2d6" />
      <rect x="178" y="80" width="24" height="10" rx="2" fill="#c9c2b2" />
      <g stroke="#141416" stroke-opacity=".55" stroke-width="2"><path d="M185 200 h10 M185 210 h10 M185 220 h10 M185 230 h10 M185 240 h10 M185 250 h10 M185 260 h10" /></g>
      <g transform="translate(250 54)">
        <rect width="28" height="46" rx="5" fill="#f3f2ef" /><rect y="-8" width="28" height="12" rx="3" fill="#2c2c31" /><rect x="5" y="22" width="18" height="18" rx="2" fill="#7c4a32" />
      </g>
      <g transform="translate(292 50)">
        <rect width="30" height="50" rx="6" fill="#dbe9ec" /><rect y="-8" width="30" height="12" rx="3" fill="#2c2c31" /><rect x="5" y="20" width="20" height="24" rx="3" fill="#6a8c94" />
      </g>
      <g transform="translate(70 70)" fill="none" stroke="#9fbf9a" stroke-width="2" stroke-linecap="round">
        <path d="M0 34 C 4 14, 18 4, 36 2 C 34 20, 22 32, 0 34Z" /><path d="M0 34 L 22 16" />
      </g>
    </g>
  )}
</svg>

<style>
  .service-art { width: 100%; height: 100%; display: block; }
</style>
