  </g>
  <g font-family="Public Sans, system-ui, sans-serif" font-weight="600" fill="#eef0ea" font-size="14">
    <text x="146" y="166">DFW Airport</text>
    <circle cx="60" cy="236" r="7" fill="#cbc2ae" /><text x="44" y="200" font-size="15">Fort Worth</text>
    <circle cx="140" cy="262" r="6" fill="#cbc2ae" /><text x="118" y="292">Arlington</text>
    <circle cx="330" cy="236" r="7" fill="#cbc2ae" /><text x="306" y="194" font-size="15">Dallas</text>
  </g>
  <g transform="translate(248 206)">
    <circle r="30" fill="#b0491f" opacity=".2" />
