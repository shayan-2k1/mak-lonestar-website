---
// Schematic (not to scale) map showing the Irving office relative to Dallas, Fort Worth and DFW Airport.
---
<svg viewBox="0 0 400 400" role="img" aria-label="Schematic map: MAK Lonestar's office in Irving, between Dallas and Fort Worth, south of DFW Airport" class="office-map">
  <rect width="400" height="400" fill="#13201b" />
  <g stroke="#eef0ea" stroke-opacity=".05"><path d="M0 50h400M0 100h400M0 150h400M0 200h400M0 250h400M0 300h400M0 350h400M50 0v400M100 0v400M150 0v400M200 0v400M250 0v400M300 0v400M350 0v400" /></g>
  <path d="M300 60 C 300 40, 340 60, 350 110 C 360 170, 330 230, 360 300" fill="none" stroke="#4f6a73" stroke-width="10" stroke-linecap="round" opacity=".55" />
  <g fill="none" stroke-linecap="round">
    <path d="M30 262 C 120 258, 220 268, 370 252" stroke="#6e8279" stroke-width="5" />
    <path d="M30 222 C 110 214, 170 206, 240 206 S 330 212, 370 214" stroke="#a9b8b0" stroke-width="5" />
    <path d="M140 110 C 220 92, 300 96, 360 130" stroke="#6e8279" stroke-width="4" stroke-dasharray="2 0" />
  </g>
  <g font-family="Public Sans, system-ui, sans-serif" font-size="12" fill="#b9c3bc">
    <text x="36" y="282">I-30</text><text x="176" y="196">SH-183</text><text x="146" y="100">I-635</text>
