    <path d="M0 0 l-8 -10 h16z" fill="#b0491f" />
    <circle cy="-19" r="6.5" fill="#fff" />
  </g>
  <g transform="translate(206 318)">
    <rect width="168" height="52" rx="10" fill="#f1eee7" />
    <text x="14" y="22" font-family="Archivo, system-ui, sans-serif" font-weight="700" font-size="14" fill="#13201b">MAK Lonestar office</text>
    <text x="14" y="40" font-family="Public Sans, system-ui, sans-serif" font-size="12" fill="#4f5a54">940 N Beltline Rd, Irving</text>
  </g>
  <path d="M248 222 L 262 318" stroke="#f1eee7" stroke-width="1.5" stroke-dasharray="3 3" />
