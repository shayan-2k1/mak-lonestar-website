---
// MAK Lonestar Consulting logo (from the firm's current website, background removed).
// `light` is the reversed version for dark backgrounds. Replace with SVG originals when available.
interface Props { href?: string; light?: boolean }
const { href = '/', light = false } = Astro.props;
const file = light ? 'mak-lonestar-logo-light' : 'mak-lonestar-logo';
---
<a class="brand" href={href}>
  <img
    src={`/images/${file}-480.webp`}
    srcset={`/images/${file}-480.webp 480w, /images/${file}-960.webp 960w`}
    sizes="(max-width: 600px) 150px, 180px"
    width="480" height="146"
    alt="MAK Lonestar Consulting"
    decoding="async"
    fetchpriority={light ? undefined : 'high'}
  />
</a>
