---
// Temporary wordmark for the prototype. Replace with the official MAK Lonestar logo files
// (SVG preferred) before launch — see docs/OWNER-CONFIRMATION.md.
interface Props { href?: string; footer?: boolean }
const { href = '/' } = Astro.props;
---
<a class="brand" href={href}>
  <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="9" fill="#b0491f"/><path d="M9 0h22a9 9 0 0 1 9 9v20H0V9a9 9 0 0 1 9-9z" fill="#13201b"/>
    <path d="M20 6.5l3.3 7 7.6.9-5.6 5.2 1.5 7.5L20 23.4l-6.8 3.7 1.5-7.5-5.6-5.2 7.6-.9z" fill="#f1eee7" />
    <rect x="19" y="27" width="2" height="9" fill="#f1eee7" />
  </svg>
  <span class="brand-name"><b>MAK Lonestar</b><span>Consulting, LLC</span></span>
</a>
