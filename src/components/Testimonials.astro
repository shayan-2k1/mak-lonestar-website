---
import { testimonials } from '../data/testimonials';
interface Props { limit?: number }
const { limit = testimonials.length } = Astro.props;
const items = testimonials.slice(0, limit);
---
<div class="quotes">
  {items.map((t, i) => (
    <figure class:list={['quote', { 'quote--lead': i === 0 }]}>
      <blockquote><p>“{t.quote}”</p></blockquote>
      <figcaption><b>{t.name}</b><span>{t.role}</span>{t.context && <span class="ctx">{t.context}</span>}</figcaption>
    </figure>
  ))}
</div>
<style>
  .quotes { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(16px, 2vw, 24px); }
  .quote { margin: 0; grid-column: span 2; background: var(--ink-2); border: 1px solid var(--ink-3); border-radius: var(--radius-lg); padding: clamp(22px, 2.4vw, 30px); display: flex; flex-direction: column; justify-content: space-between; gap: 22px; }
  .quote--lead { grid-column: span 4; background: var(--clay); border-color: var(--clay); }
  .quote--lead blockquote p { font-size: clamp(1.35rem, 1rem + 1.2vw, 1.8rem); line-height: 1.3; color: #fff; }
  .quote:nth-child(2) { grid-column: span 2; }
  .quote:nth-child(n+3) { grid-column: span 2; }
  blockquote { margin: 0; }
  blockquote p { margin: 0; font: 500 1.125rem/1.45 var(--font-head); font-stretch: 102%; color: var(--on-ink); max-width: none; }
  figcaption { display: grid; gap: 3px; font-size: 0.9rem; color: var(--on-ink-muted); }
  figcaption b { color: var(--on-ink); font-weight: 650; }
  .quote--lead figcaption { color: #fff4ee; }
  .quote--lead figcaption b { color: #fff; }
  .ctx { font-style: italic; }
  @media (max-width: 900px) { .quotes { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .quote, .quote--lead, .quote:nth-child(n) { grid-column: span 1; } .quote--lead { grid-column: 1 / -1; } }
  @media (max-width: 600px) { .quotes { grid-template-columns: minmax(0, 1fr); } }
</style>
