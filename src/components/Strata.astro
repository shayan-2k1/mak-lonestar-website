---
// Process steps drawn as soil strata: each step is one layer, deeper = later.
interface Props { steps: { title: string; text: string }[]; label?: string }
const { steps, label = 'Our process' } = Astro.props;
const layers = [
  { c: '#4b3d31' }, { c: '#7c4a32' }, { c: '#84502f' }, { c: '#b88d66', t: '#141416' }, { c: '#62655f' }, { c: '#cbc2ae', t: '#141416' },
];
---
<ol class="strata" aria-label={label}>
  {steps.map((s, i) => (
    <li style={`--c:${layers[i % layers.length].c};${layers[i % layers.length].t ? `--t:${layers[i % layers.length].t}` : ''}`}>
      <span class="depth">Step {i + 1}</span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>
