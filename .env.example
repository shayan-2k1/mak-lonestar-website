# Canonical origin for canonical URLs, Open Graph tags and sitemap.xml
SITE_URL=https://maklonestar.com

# Search indexing. Leave "false" on preview deployments so the prototype
# never competes with the live site in Google. Set "true" only on production.
PUBLIC_ALLOW_INDEXING=false

# Optional form endpoint that accepts multipart/form-data POSTs
# (e.g. Formspree, Basin, Web3Forms or your own API). When empty, forms run in
# demonstration mode: they validate and clearly tell the visitor nothing was sent.
PUBLIC_FORM_ENDPOINT=
